\section*{Research Experience}
\leaders\vrule width \textwidth\vskip0.4pt
\vskip\medskipamount
\nointerlineskip
{% for re in cv.sections.research_experience %}
    \noindent \textbf{ {{- re.position -}} } \hfill {{ re.start_date }} -- {{ re.end_date }} \\
    \textit{ \href{ {{- re.url -}} }{ {{- re.company -}} } } \hfill {{ re.location }} \\
    \noindent {{ re.highlights | join('\n \n \\noindent ') }}
