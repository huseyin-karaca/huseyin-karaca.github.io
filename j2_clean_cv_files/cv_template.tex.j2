        {%- if sn.network == 'LinkedIn' -%}
            \href{https://www.linkedin.com/in/{{ sn.username }}}{\faLinkedin~{{ sn.username }}} \quad
        {%- elif sn.network == 'Google Scholar' -%}
            \href{https://scholar.google.com/scholar?q={{ sn.username | replace(' ', '+') }}}{\faGraduationCap~{{ sn.username }}} \quad
        {%- elif sn.network == 'GitHub' -%}
            \href{https://github.com/{{ sn.username }}}{\faGithub~{{ sn.username }}} \quad
        {%- endif -%}
    {%- endfor -%}
\end{center}

\section*{Education}
\leaders\vrule width \textwidth\vskip0.4pt % or other desired thickness
\vskip\medskipamount % ditto
\nointerlineskip
{% for edu in cv.sections.education %}
    \noindent \textbf{ {{- edu.degree -}} } in {{ edu.area }} \hfill {{ edu.start_date }} -- {{ edu.end_date }} \\
    \textit{ \href{ {{- edu.url -}} }{ {{- edu.institution -}} } }\hfill {{ edu.location }} \\
    \noindent {{ edu.highlights | join('\n \n \\noindent ') }}
    \medskip
{% endfor %}

