\begin{center}
    {\Huge \textbf{ {{- cv.name -}} }} \\ \vspace{5pt}
    
    \href{mailto:{{ cv.email }}}{\faEnvelope~{{ cv.email }}} \quad
    \href{tel:{{ cv.phone | replace(' ', '') }}}{\faPhone~{{ cv.phone }}} \quad
    \faHome~{{ cv.address }} \quad
    \href{ {{- cv.website -}} }{\faLink~{{ cv.website | replace('https://', '') | replace('http://', '') }}} \quad
