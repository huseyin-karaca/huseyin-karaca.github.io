{% endfor %}

\vspace{-0.2 cm}
\section*{Publications}
\leaders\vrule width \textwidth\vskip0.4pt
\vskip\medskipamount
\nointerlineskip

{% for type, prefix in [('journal', 'J'), ('conference', 'C'), ('preprint', 'P')] %}
    {% set pubs = cv.sections.publications | selectattr('doc_type', 'equalto', type) | list %}
    {% if pubs %}
        \begin{itemize}
        \setlength{\itemsep}{0.2em}
        {% for pub in pubs %}
        \item[{{ prefix }}{{ loop.revindex }}] {{ pub.authors | join(', ') | bold_name }}. ``{{ pub.title }}''. {% if pub.journal %}\textit{ {{- pub.journal -}} }{% elif pub.conference %}\textit{ {{- pub.conference -}} }{% endif %}{% if (pub.journal or pub.conference) and pub.date %}, {% endif %}{{ pub.date }}.{% if pub.doi %} DOI: \href{https://doi.org/{{ pub.doi }}}{ {{- pub.doi -}} }{% elif pub.url %} \href{ {{- pub.url -}} }{[Link]}{% endif %}
        {% endfor %}
        \end{itemize}
    {% endif %}
{% endfor %}

\section*{Teaching Experience}
\leaders\vrule width \textwidth\vskip0.4pt
\vskip\medskipamount
\nointerlineskip

{% for te in cv.sections.teaching_experience %}
    % Header: Position & Company on two lines (standard)
    \noindent \textbf{ {{- te.position -}} } \hfill {{ te.start_date }} -- {{ te.end_date }} \\
    \textit{ {{- te.company -}} } \hfill {{ te.location }}

    % Compact Course List
    {% if te.courses %}
    \noindent {{ te.summary }} 
        {% for course in te.courses %}
            \noindent - \textit{ {{- course.name -}} } \textit{({{ course.semester }}, {{ course.coordinator }})}.
        {% endfor %}
    {% endif %}
    
    % Use smallskip instead of medskip between jobs to save space
    \smallskip 
{% endfor %}

