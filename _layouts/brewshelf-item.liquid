---
layout: default
---
<div class="library-item-container">
  <div class="library-header">
    <div class="library-meta">
      <h1 class="library-title">{{ page.title }}</h1>
      <h3 class="library-author">{{ page.roaster | default: page.bean }} - {{ page.origin }}</h3>
      <div class="library-details" style="display: flex; align-items: center; flex-wrap: wrap; gap: 1rem;">
        {% if page.date %}<span class="library-date"><i class="fas fa-calendar-check"></i> Brewed on: {{ page.date | date: "%d.%m.%Y" }}</span>{% endif %}
        {% if page.brewer %}<span class="library-date"><i class="fas fa-coffee"></i> Brewer: {{ page.brewer }}</span>{% endif %}
        <span class="library-status-badge status-{{ page.process | downcase | replace: ' ', '-' }}"><i class="fas fa-leaf"></i> Process: {{ page.process }}</span>
      </div>
    </div>
  </div>

  <div class="library-section brew-parameters-section">
    <h3 class="library-section-title">⚙️ Brew Parameters</h3>
    <ul style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; opacity: 0.9;">
      {% if page.grinder %}<li><strong>Grinder:</strong> {{ page.grinder }}</li>{% endif %}
      {% if page.grind_size %}<li><strong>Grind Size:</strong> {{ page.grind_size }}</li>{% endif %}
      {% if page.filter %}<li><strong>Filter:</strong> {{ page.filter }}</li>{% endif %}
      {% if page.coffee_g %}<li><strong>Coffee:</strong> {{ page.coffee_g }}g</li>{% endif %}
      {% if page.water_g %}<li><strong>Water:</strong> {{ page.water_g }}g</li>{% endif %}
      {% if page.temp_c %}<li><strong>Temperature:</strong> {{ page.temp_c }}&deg;C</li>{% endif %}
      {% if page.water %}<li><strong>Water Type:</strong> {{ page.water }}</li>{% endif %}
      {% if page.price %}<li><strong>Price:</strong> {{ page.price }}</li>{% endif %}
    </ul>
  </div>

  <div class="library-section library-annotations-section">
    <div class="library-annotations-content">
      {{ content }}
    </div>
  </div>
</div>
