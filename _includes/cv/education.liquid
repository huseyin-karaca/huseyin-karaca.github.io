<div class="card-text">
  {% for item in include.content %}
    <div class="mb-3">
      <h5 class="card-title font-weight-bold">
        {% if item.url %}<a href="{{ item.url }}">{{ item.institution }}</a>{% else %}{{ item.institution }}{% endif %}
      </h5>
      {% if item.degree and item.area %}
        <h6 class="card-subtitle mb-2 text-muted">{{ item.degree }} in {{ item.area }}</h6>
      {% endif %}
      <div class="card-subtitle mb-2 text-muted">
        <span>{{ item.location }}</span> |
        <span>
          {{ item.start_date }} - {{ item.end_date }}
        </span>
      </div>
      {% if item.summary %}
        <p>{{ item.summary }}</p>
      {% endif %}
      {% if item.highlights %}
      <ul class="card-text">
        {% for highlight in item.highlights %}
          <li>{{ highlight }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% unless forloop.last %}<hr>{% endunless %}
  {% endfor %}
</div>
